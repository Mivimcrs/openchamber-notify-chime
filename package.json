{
  "name": "openchamber-notify-chime",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "提醒音：会话结束、失败、要你回答或授权时出声，窗口开着也响；四类事件各自可选内置音效或本地文件。",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.2"
    },
    "id": "notify-chime",
    "name": "提醒音",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": ["powershell"]
        }
      },
      "sessionEvents": {
        "events": ["turn-finished", "turn-failed", "question-asked", "permission-asked"]
      }
    }
  }
}
